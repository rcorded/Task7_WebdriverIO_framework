{
  "name": "task7_webdriverio_framework2",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@types/node": "^26.2.0",
    "@wdio/allure-reporter": "^9.30.1",
    "@wdio/cli": "^9.30.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "allure-commandline": "^2.43.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "test:chrome": "wdio run ./wdio.chrome.conf.ts",
    "test:chrome:headless": "cross-env HEADLESS=true wdio run ./wdio.chrome.conf.ts",
    "test:chrome:single": "wdio run ./wdio.chrome.conf.ts --spec",
    "test:chrome:single:headless": "cross-env HEADLESS=true wdio run ./wdio.chrome.conf.ts --spec",
    "test:firefox": "wdio run ./wdio.firefox.conf.ts",
    "test:firefox:headless": "cross-env HEADLESS=true wdio run ./wdio.firefox.conf.ts",
    "test:firefox:single": "wdio run ./wdio.firefox.conf.ts --spec",
    "test:firefox:single:headless": "cross-env HEADLESS=true wdio run ./wdio.firefox.conf.ts --spec",
    "test:all": "npm run test:chrome && npm run test:firefox",
    "report:clean": "rimraf allure-results allure-report",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "test:full": "npm run report:clean && npm run test:chrome:headless && npm run report:generate"
  }
}
